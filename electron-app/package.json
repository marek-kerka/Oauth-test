{
  "name": "oauth-token-chat-app",
  "version": "1.0.0",
  "description": "Electron chat app with OAuth token authentication",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "keywords": [
    "electron",
    "oauth",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.example.oauth-chat",
    "protocols": [
      {
        "name": "MyApp Auth",
        "schemes": [
          "myapp"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
